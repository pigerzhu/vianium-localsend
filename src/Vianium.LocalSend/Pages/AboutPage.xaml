<Page
    x:Class="Vianium.LocalSend.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Margin="19,12,19,0">
        <StackPanel>
            <Image Source="/Assets/logo-128.png" Width="96" Height="96"
                   HorizontalAlignment="Center" Margin="0,20,0,12"/>
            <TextBlock Text="LocalSend" FontSize="32" FontWeight="Light"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Windows Phone 8.1"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       FontSize="15" HorizontalAlignment="Center"
                       Margin="0,2,0,24"/>

            <!-- Version -->
            <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,12">
                <StackPanel Margin="14">
                    <TextBlock x:Name="VersionLabel" FontSize="14"/>
                    <TextBlock x:Name="ProtocolLabel" FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock x:Name="PlatformLabel" FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ChangelogLink" FontSize="14" Margin="0,8,0,0"
                               Foreground="#FF3FB950" Tapped="ChangelogLink_Tapped"/>
                    <TextBlock x:Name="DiagnosticsLink" FontSize="14" Margin="0,8,0,0"
                               Foreground="#FF3FB950" Tapped="DiagnosticsLink_Tapped"/>
                </StackPanel>
            </Grid>

            <!-- Description -->
            <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,16">
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="13.5"
                           Foreground="{ThemeResource PhoneSubtleBrush}" Margin="14"/>
            </Grid>

            <!-- Compatibility -->
            <TextBlock x:Name="CompatibilitySection" FontSize="13"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,16">
                <StackPanel Margin="14">
                    <TextBlock x:Name="SendReceiveLabel" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock Text="  Android" FontSize="14" Margin="0,2"/>
                    <TextBlock Text="  iOS / iPhone / iPad" FontSize="14" Margin="0,2"/>
                    <TextBlock Text="  Windows 10 / 11" FontSize="14" Margin="0,2"/>
                    <TextBlock Text="  macOS" FontSize="14" Margin="0,2"/>
                    <TextBlock Text="  Linux" FontSize="14" Margin="0,2"/>
                    <TextBlock Text="  Windows Phone 8.1" FontSize="14"
                               FontWeight="SemiBold" Margin="0,2"/>
                    <TextBlock x:Name="CompatibilityNote" TextWrapping="Wrap"
                               FontSize="12.5" Foreground="{ThemeResource PhoneSubtleBrush}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <!-- About this port -->
            <TextBlock x:Name="PortSection" FontSize="13"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,16">
                <StackPanel Margin="14">
                    <TextBlock x:Name="FirstAndOnlyText" TextWrapping="Wrap"
                               FontSize="13.5" Foreground="{ThemeResource PhoneSubtleBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="IncludesText" TextWrapping="Wrap"
                               FontSize="13.5" Foreground="{ThemeResource PhoneSubtleBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="BuiltFromScratchText" TextWrapping="Wrap"
                               FontSize="13.5" Foreground="{ThemeResource PhoneSubtleBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Developer -->
            <TextBlock x:Name="DeveloperSection" FontSize="13"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,16">
                <StackPanel Margin="14">
                    <TextBlock Text="Angel Careaga" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RoleText" FontSize="13.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               Margin="0,2,0,8"/>
                    <TextBlock x:Name="BuiltWithLabel" FontSize="13.5" Margin="0,4,0,4"/>
                    <TextBlock x:Name="Tech1" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" Margin="8,2,0,2"/>
                    <TextBlock x:Name="Tech2" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" Margin="8,2,0,2"/>
                    <TextBlock x:Name="Tech3" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" Margin="8,2,0,2"/>
                    <TextBlock x:Name="Tech4" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" Margin="8,2,0,2"/>
                    <TextBlock x:Name="Tech5" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" Margin="8,2,0,2"/>
                    <TextBlock Text="github.com/AngelCareaga" FontSize="13"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="buymeacoffee.com/soyangelcareaga" FontSize="13"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Credits -->
            <TextBlock x:Name="CreditsSection" FontSize="13"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,16">
                <StackPanel Margin="14">
                    <TextBlock Text="LocalSend" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OriginalLabel" FontSize="13"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="localsend.org" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- License -->
            <TextBlock x:Name="LicenseSection" FontSize="13"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,30">
                <TextBlock x:Name="LicenseText" TextWrapping="Wrap" FontSize="13"
                           Foreground="{ThemeResource PhoneSubtleBrush}" Margin="14"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
