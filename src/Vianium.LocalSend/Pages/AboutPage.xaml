<Page
    x:Class="Vianium.LocalSend.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PhoneBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="19,14,19,36">

            <TextBlock x:Name="BrandText"
                       Text="VIANIUM"
                       FontSize="12"
                       FontWeight="SemiBold"
                       CharacterSpacing="220"
                       Foreground="#FF1BA1E2"
                       Margin="0,0,0,10"/>

            <TextBlock Text="LocalSend"
                       FontSize="44"
                       FontWeight="Light"
                       LineHeight="48"
                       Foreground="{ThemeResource PhoneForegroundBrush}"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="TaglineText"
                       Text=""
                       FontSize="14"
                       FontWeight="Light"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,18"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{ThemeResource PhoneChromeBrush}"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="VersionTitleText"
                                   Text="VERSION"
                                   FontSize="10.5"
                                   CharacterSpacing="160"
                                   Foreground="{ThemeResource PhoneSubtleBrush}"/>
                        <TextBlock x:Name="VersionValueText"
                                   Text="Store 1.1.0"
                                   FontSize="17"
                                   FontWeight="Light"
                                   Foreground="{ThemeResource PhoneForegroundBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{ThemeResource PhoneChromeBrush}"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="ProtocolTitleText"
                                   Text="PROTOCOL"
                                   FontSize="10.5"
                                   CharacterSpacing="160"
                                   Foreground="{ThemeResource PhoneSubtleBrush}"/>
                        <TextBlock x:Name="ProtocolValueText"
                                   Text="LocalSend v2.x"
                                   FontSize="17"
                                   FontWeight="Light"
                                   Foreground="{ThemeResource PhoneForegroundBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="DescriptionText"
                       Text=""
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       LineHeight="21"
                       Margin="0,0,0,18"/>

            <Border Background="{ThemeResource PhoneChromeBrush}"
                    Padding="14,12"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock x:Name="RepositoryLabelText"
                               Text="REPOSITORY"
                               FontSize="10.5"
                               CharacterSpacing="160"
                               Foreground="{ThemeResource PhoneSubtleBrush}"/>
                    <TextBlock x:Name="RepositoryLinkText"
                               Text="github.com/vianium/vianium-localsend"
                               FontSize="13"
                               Foreground="#FF1BA1E2"
                               TextWrapping="Wrap"
                               Margin="0,5,0,12"
                               Tapped="RepositoryLink_Tapped"/>

                    <TextBlock x:Name="LicenseSummaryText"
                               Text=""
                               FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="PrivacySummaryText"
                               Text=""
                               FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ProjectSectionText"
                       Text="PROJECT"
                       FontSize="15"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       Margin="0,0,0,8"/>
            <Border Background="{ThemeResource PhoneChromeBrush}"
                    Padding="14,14"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock x:Name="WhyText"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="13.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               LineHeight="20"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="InteropText"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="13.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               LineHeight="20"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="FeaturesSectionText"
                       Text="FEATURES"
                       FontSize="15"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       Margin="0,0,0,8"/>
            <Border Background="{ThemeResource PhoneChromeBrush}"
                    Padding="14,14"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock x:Name="Feature1Text" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Feature2Text" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Feature3Text" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Feature4Text" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Feature5Text" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Feature6Text" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Feature7Text" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Feature8Text" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TechnologySectionText"
                       Text="TECHNOLOGY"
                       FontSize="15"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       Margin="0,0,0,8"/>
            <Border Background="{ThemeResource PhoneChromeBrush}"
                    Padding="14,14"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock x:Name="TechIntroText"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="13.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               LineHeight="20"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="Tech1" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Tech2" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Tech3" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Tech4" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Tech5" FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="CompatibilitySection"
                       Text="COMPATIBILITY"
                       FontSize="15"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       Margin="0,0,0,8"/>
            <Border Background="{ThemeResource PhoneChromeBrush}"
                    Padding="14,12"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="CompatibilityDesktopText"
                               Text=""
                               FontSize="13"
                               Foreground="{ThemeResource PhoneForegroundBrush}"
                               Margin="0,2"/>
                    <TextBlock x:Name="CompatibilityMobileText"
                               Text=""
                               FontSize="13"
                               Foreground="{ThemeResource PhoneForegroundBrush}"
                               Margin="0,2"/>
                    <TextBlock x:Name="CompatibilityClientsText"
                               Text=""
                               FontSize="13"
                               Foreground="{ThemeResource PhoneForegroundBrush}"
                               Margin="0,2"/>
                    <TextBlock x:Name="CompatibilityPhoneText"
                               Text="Windows Phone 8.1"
                               FontSize="13"
                               Foreground="#FF1BA1E2"
                               Margin="0,2"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="CompatibilityNote"
                       Text=""
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       LineHeight="18"
                       Margin="0,0,0,24"/>

            <TextBlock x:Name="HistorySectionText"
                       Text="HISTORY"
                       FontSize="15"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       Margin="0,0,0,8"/>
            <Border Background="{ThemeResource PhoneChromeBrush}"
                    Padding="14,14"
                    Margin="0,0,0,24">
                <TextBlock x:Name="HistoryText"
                           Text=""
                           TextWrapping="Wrap"
                           FontSize="12.5"
                           Foreground="{ThemeResource PhoneSubtleBrush}"
                           LineHeight="18"/>
            </Border>

            <TextBlock x:Name="CreditsSection"
                       Text="CREDITS"
                       FontSize="15"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       Margin="0,0,0,8"/>
            <Border Background="{ThemeResource PhoneChromeBrush}"
                    Padding="14,14"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Angel Careaga"
                               FontSize="17"
                               Foreground="{ThemeResource PhoneForegroundBrush}"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="AuthorText"
                               Text=""
                               FontSize="12.5"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="AuthorLinkText"
                               Text="angelcareaga.com"
                               FontSize="13"
                               Foreground="#FF1BA1E2"
                               Margin="0,0,0,8"
                               Tapped="AuthorLink_Tapped"/>
                    <TextBlock Text="localsend.org"
                               FontSize="13"
                               Foreground="#FF1BA1E2"
                               Margin="0,0,0,8"
                               Tapped="LocalSendLink_Tapped"/>
                    <TextBlock Text="discord.gg/NccbAK6jeb"
                               FontSize="13"
                               Foreground="#FF1BA1E2"
                               Tapped="SupportLink_Tapped"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="ChangelogLink"
                           Text="changelog"
                           FontSize="14"
                           Foreground="#FF1BA1E2"
                           Margin="0,0,24,0"
                           Tapped="ChangelogLink_Tapped"/>
                <TextBlock x:Name="DiagnosticsLink"
                           Text="diagnostics"
                           FontSize="14"
                           Foreground="#FF1BA1E2"
                           Tapped="DiagnosticsLink_Tapped"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
