<Page
    x:Class="Vianium.LocalSend.Pages.TransferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PhoneBackgroundBrush}">

    <Grid x:Name="PageGrid" Background="{ThemeResource PhoneBackgroundBrush}">
        <Grid x:Name="ProgressLayout" Background="{ThemeResource PhoneBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="17,24,17,24">
                    <TextBlock Text="LOCALSEND"
                               FontSize="12"
                               FontWeight="SemiBold"
                               CharacterSpacing="420"
                               Foreground="{ThemeResource PhoneForegroundBrush}"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="TransferTitleText"
                               Text="enviando"
                               FontSize="54"
                               FontWeight="Light"
                               LineHeight="58"
                               Foreground="{ThemeResource PhoneForegroundBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="TransferPeerText"
                               Text="a Secret Avocado"
                               FontSize="13"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               Margin="0,2,0,42"/>

                    <TextBlock x:Name="ProgressPercentText"
                               Text="0%"
                               FontSize="110"
                               FontWeight="Light"
                               LineHeight="112"
                               Foreground="{ThemeResource PhoneForegroundBrush}"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               Margin="0,0,0,12"/>

                    <Grid x:Name="ProgressTrack"
                          Height="4"
                          Background="{ThemeResource PhoneChromeBrush}"
                          Margin="0,0,0,0">
                        <Rectangle x:Name="ProgressFill"
                                   Fill="#FF1BA1E2"
                                   HorizontalAlignment="Left"
                                   Width="0"/>
                    </Grid>

                    <Border x:Name="CurrentFilePanel"
                            BorderBrush="{ThemeResource PhoneChromeBrush}"
                            BorderThickness="0,1,0,1"
                            Margin="0,0,0,24">
                        <Grid MinHeight="72">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="#FF1BA1E2"
                                       VerticalAlignment="Stretch"
                                       Margin="0,10,0,10"/>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="14,8,0,8">
                                <TextBlock x:Name="CurrentFileIndexText"
                                           Text="1 DE 3"
                                           FontSize="10"
                                           CharacterSpacing="160"
                                           Foreground="{ThemeResource PhoneSubtleBrush}"/>
                                <TextBlock x:Name="CurrentFileNameText"
                                           Text="IMG_4521.jpg"
                                           FontSize="14"
                                           Foreground="{ThemeResource PhoneForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CurrentFileSizeText"
                                           Text="3.2 MB"
                                           FontSize="11"
                                           Foreground="{ThemeResource PhoneSubtleBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="RemainingLabelText"
                                       Text="RESTANTE"
                                       FontSize="10"
                                       CharacterSpacing="220"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"/>
                            <TextBlock x:Name="RemainingValueText"
                                       Text="--"
                                       FontSize="27"
                                       FontWeight="Light"
                                       Foreground="{ThemeResource PhoneForegroundBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="SpeedLabelText"
                                       Text="VELOCIDAD"
                                       FontSize="10"
                                       CharacterSpacing="220"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"/>
                            <TextBlock x:Name="SpeedValueText"
                                       Text="--"
                                       FontSize="27"
                                       FontWeight="Light"
                                       Foreground="{ThemeResource PhoneForegroundBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1"
                  x:Name="ProgressActions"
                  Margin="17,0,17,18"
                  Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MinimizeButton"
                        Grid.Column="0"
                        Content="MINIMIZAR"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderBrush="{ThemeResource PhoneForegroundBrush}"
                        Foreground="{ThemeResource PhoneForegroundBrush}"
                        FontSize="12"
                        CharacterSpacing="120"
                        Click="MinimizeButton_Click"/>

                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Content="CANCELAR"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderBrush="#FFE81123"
                        Foreground="#FFE81123"
                        FontSize="12"
                        CharacterSpacing="120"
                        Click="CancelButton_Click"/>
            </Grid>
        </Grid>

        <Grid x:Name="CompleteLayout"
              Visibility="Collapsed"
              Background="#FF1BA1E2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="14,24,14,24">
                <TextBlock Text="LOCALSEND"
                           FontSize="12"
                           FontWeight="SemiBold"
                           CharacterSpacing="420"
                           Foreground="White"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="CompleteTitleText"
                           Text="transferencia completa"
                           FontSize="54"
                           FontWeight="Light"
                           LineHeight="58"
                           Foreground="White"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="CompletePeerText"
                           Text="a Secret Avocado"
                           FontSize="13"
                           Foreground="#CCFFFFFF"
                           Margin="0,4,0,62"/>

                <TextBlock Text="&#x2713;"
                           FontSize="168"
                           FontWeight="Light"
                           Foreground="White"
                           HorizontalAlignment="Right"
                           LineHeight="172"
                           Margin="0,0,4,0"/>

                <Border Height="4"
                        Background="#EEFFFFFF"
                        Margin="0,0,0,48"/>

                <TextBlock x:Name="CompleteFilesText"
                           Text="3 archivos"
                           FontSize="23"
                           FontWeight="Light"
                           Foreground="White"/>

                <TextBlock x:Name="CompleteSizeText"
                           Text="30.0 MB"
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="White"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Button x:Name="DoneButton"
                    Grid.Row="1"
                    Content="LISTO"
                    HorizontalAlignment="Stretch"
                    Height="46"
                    Margin="14,0,14,18"
                    Background="Transparent"
                    BorderBrush="White"
                    Foreground="White"
                    FontSize="12"
                    CharacterSpacing="160"
                    Click="DoneButton_Click"/>
        </Grid>
    </Grid>
</Page>
