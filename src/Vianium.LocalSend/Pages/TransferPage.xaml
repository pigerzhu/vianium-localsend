<Page
    x:Class="Vianium.LocalSend.Pages.TransferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="19,12,19,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="TransferTitleText"
                   Text=""
                   FontSize="26" FontWeight="Light"
                   Margin="0,0,0,4"/>

        <!-- Device info -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="&#xE1C9;" FontFamily="Segoe UI Symbol"
                       FontSize="16" VerticalAlignment="Center"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       Margin="0,0,8,0"/>
            <TextBlock x:Name="DeviceInfoText" Text=""
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       FontSize="14.5" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Overall progress -->
        <Border Grid.Row="2" Background="{ThemeResource PhoneChromeBrush}"
                Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <ProgressBar x:Name="OverallProgressBar"
                             Minimum="0" Maximum="100" Value="0"
                             Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressText"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               FontSize="13" Text="0%"/>
                    <TextBlock x:Name="FilesCountText" Grid.Column="1"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               FontSize="13" Text=""/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- File list -->
        <ListView x:Name="FilesList" Grid.Row="3"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- File icon -->
                        <Border Width="36" Height="36"
                                Background="{ThemeResource PhoneChromeBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="&#xE160;" FontFamily="Segoe UI Symbol"
                                       FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <!-- File info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SizeText}"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                        <!-- Status -->
                        <TextBlock Grid.Column="2" Text="{Binding StatusIcon}"
                                   FontFamily="Segoe UI Symbol" FontSize="18"
                                   Foreground="{Binding StatusColor}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Data size -->
        <TextBlock x:Name="DataSizeText" Grid.Row="4"
                   Foreground="{ThemeResource PhoneSubtleBrush}"
                   FontSize="13" HorizontalAlignment="Center"
                   Margin="0,4,0,8"/>

        <!-- Action button -->
        <Button x:Name="ActionButton" Grid.Row="5"
                Content="Cancelar"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,12"
                Click="ActionButton_Click"/>
    </Grid>
</Page>
