<Page
    x:Class="Vianium.LocalSend.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Pivot Title="LOCALSEND" x:Name="MainPivot">

        <!-- TAB 1: RECIBIR -->
        <PivotItem x:Name="Tab1Header" Header="recibir">
            <StackPanel Margin="0,8,0,0">
                <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,10">
                    <StackPanel Margin="14">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                     Fill="#FF8B949E" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ServerStatusText" Text=""
                                       FontSize="15"/>
                        </StackPanel>
                        <TextBlock x:Name="LocalIpText" FontSize="13"
                                   Foreground="{ThemeResource PhoneSubtleBrush}"
                                   Margin="20,3,0,0"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="DeviceAliasDisplay" Text=""
                           FontSize="28" FontWeight="Light"
                           HorizontalAlignment="Center" Margin="0,8,0,2"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="DeviceModelDisplay" Text=""
                           Foreground="{ThemeResource PhoneSubtleBrush}"
                           FontSize="14" HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HistoryBtn" Content="" HorizontalAlignment="Stretch"
                            Margin="0,0,4,0" Click="HistoryButton_Click"/>
                    <Button x:Name="AboutBtn" Grid.Column="1" Content=""
                            HorizontalAlignment="Stretch" Margin="4,0,0,0"
                            Click="AboutButton_Click"/>
                </Grid>
                <TextBlock x:Name="ReceivedFilesLabel" Text="" FontSize="17"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="NoReceivedFilesText" Text=""
                           Foreground="{ThemeResource PhoneSubtleBrush}"
                           FontSize="14" FontStyle="Italic"/>
                <ListView x:Name="ReceivedFilesList" MaxHeight="300" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FileName}" FontSize="14"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                           Foreground="{ThemeResource PhoneSubtleBrush}"
                                           FontSize="12.5"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="ReceiveProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid Background="{ThemeResource PhoneChromeBrush}">
                        <StackPanel Margin="14">
                            <TextBlock x:Name="ReceiveProgressTitle" Text=""
                                       FontSize="15" FontWeight="SemiBold"/>
                            <ProgressBar x:Name="ReceiveProgressBar" Minimum="0" Maximum="100"
                                         Value="0" Margin="0,6,0,3"/>
                            <TextBlock x:Name="ReceiveProgressText" FontSize="13"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </PivotItem>

        <!-- TAB 2: ENVIAR -->
        <PivotItem x:Name="Tab2Header" Header="enviar">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Background="{ThemeResource PhoneChromeBrush}">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SelectedFilesText" Text=""
                                   FontSize="14.5" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+" FontSize="20"
                                MinWidth="48" Click="PickFilesButton_Click"/>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TextMessageBox" PlaceholderText=""
                             TextChanged="TextMessageBox_TextChanged"/>
                    <Button x:Name="SendTextButton" Grid.Column="1"
                            Content=">" FontSize="18" MinWidth="48"
                            IsEnabled="False" Click="SendTextButton_Click"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,12,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NearbyDevicesLabel" Text="" FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="DeviceCountText" Grid.Column="1" Text=""
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="RefreshButton" Grid.Column="2"
                            Content="" MinWidth="44" Padding="8,4"
                            Click="RefreshButton_Click"/>
                </Grid>
                <ListView x:Name="DevicesList" Grid.Row="3"
                          SelectionMode="Single"
                          SelectionChanged="DevicesList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Alias}" FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{ThemeResource PhoneSubtleBrush}"
                                               FontSize="12.5">
                                        <Run Text="{Binding DeviceModel}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding ProtocolLabel}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding IpAddress}"
                                           Foreground="{ThemeResource PhoneSubtleBrush}"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="NoDevicesText" Grid.Row="3" Text=""
                           Foreground="{ThemeResource PhoneSubtleBrush}"
                           FontSize="14" FontStyle="Italic"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Button x:Name="SendButton" Grid.Row="4" Content=""
                        HorizontalAlignment="Stretch" IsEnabled="False"
                        Margin="0,6,0,4" Click="SendButton_Click"/>
            </Grid>
        </PivotItem>

        <!-- TAB 3: AJUSTES -->
        <PivotItem x:Name="Tab3Header" Header="ajustes">
            <ScrollViewer>
                <StackPanel Margin="0,8,0,20">
                    <TextBlock x:Name="DeviceSectionLabel" Text="" FontSize="13"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,16">
                        <StackPanel Margin="14">
                            <TextBlock x:Name="NameLabel" Text="" FontSize="14"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="AliasTextBox" PlaceholderText=""
                                     LostFocus="AliasTextBox_LostFocus"/>
                            <TextBlock x:Name="ModelLabel" Text="" FontSize="14"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       Margin="0,12,0,2"/>
                            <TextBlock x:Name="DeviceModelText" FontSize="14.5"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="NetworkSectionLabel" Text="" FontSize="13"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,16">
                        <StackPanel Margin="14">
                            <TextBlock x:Name="PortLabel" FontSize="14"/>
                            <TextBlock x:Name="ProtocolLabel" FontSize="14" Margin="0,4,0,0"/>
                            <TextBlock Text="Fingerprint" FontSize="14"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       Margin="0,8,0,2"/>
                            <TextBlock x:Name="FingerprintText" FontSize="11"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="StorageSectionLabel" Text="" FontSize="13"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,16">
                        <StackPanel Margin="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ImagesLabel" Text="" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="ImageDestButton" Grid.Column="1"
                                        Content="" MinWidth="100"
                                        Click="ImageDestButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="ImagePathHint" FontSize="11.5"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="VideosLabel" Text="" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="VideoDestButton" Grid.Column="1"
                                        Content="" MinWidth="100"
                                        Click="VideoDestButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="VideoPathHint" FontSize="11.5"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AudioLabel" Text="" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="AudioDestButton" Grid.Column="1"
                                        Content="" MinWidth="100"
                                        Click="AudioDestButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="AudioPathHint" FontSize="11.5"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OtherFilesLabel" Text="" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="OtherDestButton" Grid.Column="1"
                                        Content="" MinWidth="100"
                                        Click="OtherDestButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="OtherPathHint" FontSize="11.5"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,0"/>
                            <Button x:Name="MigrateButton" HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0" Visibility="Collapsed"
                                    Click="MigrateButton_Click"/>
                            <ProgressBar x:Name="MigrateProgress" Minimum="0" Maximum="100"
                                         Visibility="Collapsed" Margin="0,6,0,0"/>
                            <TextBlock x:Name="MigrateStatusText" FontSize="12.5"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       Visibility="Collapsed" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="LangSectionLabel" Text="" FontSize="13"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Background="{ThemeResource PhoneChromeBrush}" Margin="0,0,0,16">
                        <Grid Margin="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LangEsButton" Content="Español"
                                    HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                    Click="LangEsButton_Click"/>
                            <Button x:Name="LangEnButton" Grid.Column="1"
                                    Content="English" HorizontalAlignment="Stretch"
                                    Margin="4,0,0,0" Click="LangEnButton_Click"/>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="AppSectionLabel" Text="APP" FontSize="13"
                               Foreground="{ThemeResource PhoneSubtleBrush}"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Background="{ThemeResource PhoneChromeBrush}">
                        <Grid Margin="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="LocalSend v1.0.1" FontSize="14"/>
                                <TextBlock Text="Protocol v2.1" FontSize="12.5"
                                           Foreground="{ThemeResource PhoneSubtleBrush}"/>
                            </StackPanel>
                            <Button x:Name="AboutBtn2" Grid.Column="1" Content=""
                                    Click="AboutButton_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</Page>
