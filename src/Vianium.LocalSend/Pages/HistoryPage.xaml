<Page
    x:Class="Vianium.LocalSend.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PhoneBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,24,20,18">
            <TextBlock Text="LOCALSEND"
                       FontSize="12"
                       CharacterSpacing="420"
                       Foreground="{ThemeResource PhoneForegroundBrush}"/>
            <TextBlock x:Name="HistoryTitleText"
                       Text="historial"
                       FontSize="54"
                       FontWeight="Light"
                       LineHeight="58"
                       Margin="0,10,0,2"
                       Foreground="{ThemeResource PhoneForegroundBrush}"/>
            <TextBlock x:Name="HistoryCountText"
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       FontSize="13"/>
        </StackPanel>

        <ListView x:Name="HistoryList"
                  Grid.Row="1"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Text="{Binding HeaderText}"
                                   Visibility="{Binding HeaderVisibility}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="240"
                                   Foreground="#FF1BA1E2"
                                   Margin="20,16,20,7"/>

                        <Border Visibility="{Binding TransferVisibility}"
                                BorderBrush="{ThemeResource PhoneChromeBrush}"
                                BorderThickness="0,1,0,0"
                                MinHeight="62">
                            <Grid Margin="20,0,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="18"
                                           Foreground="{ThemeResource PhoneSubtleBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>

                                <StackPanel Grid.Column="1"
                                            Margin="10,9,8,8"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               Foreground="{ThemeResource PhoneForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,2,0,0">
                                        <TextBlock Text="{Binding DirectionText}"
                                                   FontSize="12"
                                                   Foreground="{Binding DirectionBrush}"/>
                                        <TextBlock Text="{Binding DetailText}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource PhoneSubtleBrush}"
                                                   Margin="4,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding TimeText}"
                                           FontSize="11.5"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource PhoneSubtleBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="EmptyText"
                       Text=""
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Button x:Name="ClearButton"
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                Height="42"
                Margin="20,8,20,20"
                Background="Transparent"
                BorderBrush="{ThemeResource PhoneForegroundBrush}"
                BorderThickness="1"
                Padding="0"
                Click="ClearButton_Click">
            <TextBlock x:Name="ClearButtonText"
                       Text="BORRAR HISTORIAL"
                       FontSize="12"
                       CharacterSpacing="220"
                       Foreground="{ThemeResource PhoneForegroundBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Button>
    </Grid>
</Page>
