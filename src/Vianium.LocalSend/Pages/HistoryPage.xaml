<Page
    x:Class="Vianium.LocalSend.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="19,12,19,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="HistoryTitleText" Text="" FontSize="26" FontWeight="Light"/>
            <TextBlock x:Name="HistoryCountText"
                       Foreground="{ThemeResource PhoneSubtleBrush}" FontSize="13"/>
        </StackPanel>

        <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DirectionText}"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding TimeText}"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       FontSize="11.5" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding SizeText}"
                                       Foreground="{ThemeResource PhoneSubtleBrush}"
                                       FontSize="11.5" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyState" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="EmptyText" Text=""
                       Foreground="{ThemeResource PhoneSubtleBrush}"
                       FontSize="14" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,8,0,12">
            <Button x:Name="ClearButton" Content="" Margin="0,0,8,0"
                    Click="ClearButton_Click"/>
            <Button x:Name="BackButton" Content="" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
